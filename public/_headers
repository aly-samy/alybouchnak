/*
  # Enable Early Hints for critical fonts (static names)
  Link: </fonts/fredoka-regular.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  Link: </fonts/nunito-regular.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  Link: </fonts/nunito-700.woff2>; rel=preload; as=font; type=font/woff2; crossorigin
  
  # Security Headers
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: upgrade-insecure-requests; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://www.googletagmanager.com https://connect.facebook.net https://*.disqus.com;

/admin*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/manage-subscription
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/llms.txt
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600

/ai-catalog.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/.well-known/*.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

/music-catalog.json
  Content-Type: application/ld+json; charset=utf-8
  Cache-Control: public, max-age=3600

/music-discovery.json
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=3600

# Maximize caching for static assets in /assets/
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Maximize caching for fonts
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
